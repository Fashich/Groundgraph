{
  "name": "@groundgraph/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Groundgraph database schema, migrations and typed queries",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "migrate": "tsx src/cli-migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3"
  }
}
