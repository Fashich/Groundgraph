SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
RPC_WS_URL=wss://api.devnet.solana.com
# Optional: Helius (free tier, no card) for faster indexing and historical backfill
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
PROGRAM_ID=
USDC_MINT=
PYTH_HERMES_URL=https://hermes.pyth.network
DATABASE_URL=postgres://groundgraph:groundgraph@localhost:5432/groundgraph
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-to-a-long-random-string
TOS_VERSION=2026-10-01
# Path to the keeper keypair json (low-balance devnet hot wallet only)
KEEPER_KEYPAIR=./.keys/keeper.json
BLOCKED_COUNTRIES=US
SENTRY_DSN=
# true only for local demos: enables clearly labelled seeded/demo data
DEMO_MODE=false

# ---------------------------------------------------------------------------------------------------------------------
# Backend services (services/api, services/indexer, services/keeper). Full reference: services/README.md
# Services read process.env only: export this file (set -a; . ./.env; set +a) or pass it to Docker / your process manager.
# Empty optional values mean "unset". Numbers and booleans fall back to their defaults when left empty.
# ---------------------------------------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Apply packages/db/migrations on boot (safe for all three services, guarded by an advisory lock)
RUN_MIGRATIONS=true
# Pyth Hermes and Benchmarks need a key since the Pyth Core upgrade. Without one the keeper settles SOL and ETH markets from the
# on-chain push feeds only (loud warning at start) and volatility comes from Coinbase daily candles.
PYTH_API_KEY=
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network
# If set, GET /metrics on every service requires "Authorization: Bearer <token>" (health endpoints stay open)
METRICS_TOKEN=
# Responsible trading and oracle freshness (shared by api, indexer, keeper so they agree)
DEFAULT_DAILY_LIMIT_USDC=500
ORACLE_STALE_SECS=60
FAIR_VALUE_MAX_SPOT_AGE_SECS=900

# --- api ---
API_HOST=0.0.0.0
API_PORT=8787
# Browser origin of the web app (CORS, CSRF origin check, SIWS domain) and the public URL of this API (Blink links, OG images)
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8787
SESSION_TTL_HOURS=168
COOKIE_NAME=gg_session
COOKIE_STRICT=false
# true behind HTTPS
COOKIE_SECURE=false
# true behind a reverse proxy (client IP and country headers are trusted)
TRUST_PROXY=false
# Simulate every unsigned transaction before returning it
SIMULATE_TX=true
DEFAULT_PRIORITY_FEE_MICROLAMPORTS=5000
MAX_PRIORITY_FEE_MICROLAMPORTS=200000
RATE_LIMIT_PER_MINUTE=600
WS_MAX_CONNECTIONS_PER_IP=30
WS_MAX_BUFFER_BYTES=1048576
# Devnet test USDC faucet: path to (or inline JSON of) the mint authority keypair. Empty = faucet disabled.
FAUCET_KEYPAIR=
FAUCET_AMOUNT_USDC=1000
FAUCET_MAX_PER_WALLET_PER_DAY=3
FAUCET_MAX_PER_IP_PER_DAY=6

# --- indexer ---
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_BATCH_SIZE=100
INDEXER_TX_CONCURRENCY=4
INDEXER_RECONCILE_INTERVAL_SECS=60
INDEXER_FINALIZE_INTERVAL_SECS=20
INDEXER_TICK_INTERVAL_SECS=60
INDEXER_BACKFILL_ON_START=true
# Empty = automatic (on when HELIUS_API_KEY or RPC_WS_URL is set)
INDEXER_WS_NUDGE=
INDEXER_DROP_GRACE_SLOTS=64
INDEXER_METRICS_HOST=0.0.0.0
INDEXER_METRICS_PORT=9102

# --- keeper ---
# auto = Hermes when PYTH_API_KEY is set, otherwise on-chain push feeds. hermes = key required. push-feed = never use Hermes.
KEEPER_SETTLEMENT_ORACLE=auto
# Assets whose devnet push feeds are fresh enough to settle with (used when no PYTH_API_KEY)
KEEPER_PUSH_FEED_ASSETS=SOL,ETH
# false = dry run (oracle, fair values, decisions logged; nothing is sent)
KEEPER_SEND_TRANSACTIONS=true
KEEPER_ORACLE_INTERVAL_MS=2000
KEEPER_FAIRVALUE_INTERVAL_SECS=60
KEEPER_SETTLE_INTERVAL_SECS=10
KEEPER_VOL_REFRESH_MINUTES=30
KEEPER_HOUSEKEEPING_INTERVAL_MINUTES=60
KEEPER_PRIORITY_FEE_MICROLAMPORTS=5000
KEEPER_MAX_PRIORITY_FEE_MICROLAMPORTS=200000
KEEPER_CONFIRM_TIMEOUT_SECS=45
KEEPER_ALERT_AFTER_ATTEMPTS=3
# Alert when the keeper wallet holds less than this many SOL
KEEPER_MIN_SOL=0.2
KEEPER_ORACLE_RETENTION_DAYS=7
KEEPER_FAIRVALUE_RETENTION_DAYS=14
KEEPER_METRICS_HOST=0.0.0.0
KEEPER_METRICS_PORT=9101
# Alerts (all optional; without any, alerts are only logged). Webhook: Discord, Slack or any JSON endpoint.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=auto
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_DEDUPE_SECS=900

# ---------------------------------------------------------------------------------------------------------------------
# Self-hosting with docker compose (see docs/SELF_HOSTING.md). Only these are read by docker-compose.yml for substitution;
# the variables above are for running the services directly with pnpm.
# ---------------------------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Public origin users open in the browser (the tunnel URL when you expose it). SIWS domain, CORS and CSRF are pinned to it.
PUBLIC_URL=http://localhost:8080
PROXY_BIND=127.0.0.1
PROXY_PORT=8080
# SCORER_SOURCE=synthetic requires DEMO_MODE=true (clearly labelled "Demo data"); use helius with HELIUS_API_KEY for real wallets.
SCORER_SOURCE=synthetic
