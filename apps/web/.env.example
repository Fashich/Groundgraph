# Public (inlined into the browser bundle at build time)
# Base path of the API as seen by the browser. '/api' goes through the Next rewrite below.
NEXT_PUBLIC_API_URL=/api
# WebSocket endpoint. When empty it is derived: ws://localhost:8787/ws in dev, wss://<host>/ws in production.
# Next rewrites do not proxy WebSocket upgrades well, so set this in dev (the mock API listens on ws://localhost:4000/ws).
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Test USDC mint (6 decimals) used to read the wallet balance on devnet
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_TOS_VERSION=2026-10-01
# Public origin of this site, used for absolute Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server side only
# Origin the Next rewrite proxies /api/* and /og/* to. Real API: http://localhost:8787. Mock API (pnpm mock): http://localhost:4000
API_ORIGIN=http://localhost:8787
# Comma separated ISO country codes blocked by the geofence (proxy.ts). Allowed when no country header is present.
BLOCKED_COUNTRIES=US,CU,IR,KP,SY
