# Groundgraph scorer configuration (copy to .env; never commit real keys)

# Postgres (same database the API and indexer use)
DATABASE_URL=postgres://groundgraph:groundgraph@localhost:5432/groundgraph

# true only for local demos. Required for SCORER_SOURCE=synthetic. Demo rows are labelled data_source='demo-synthetic'.
DEMO_MODE=false

# synthetic | helius | onchain
SCORER_SOURCE=helius

# Optional Helius key (free tier works). Needed for SCORER_SOURCE=helius.
HELIUS_API_KEY=
# Free tier is roughly 2 enhanced-API requests per second and 10 RPC requests per second
HELIUS_ENHANCED_RPS=2
HELIUS_RPC_RPS=8
# Backfill depth in days
HELIUS_BACKFILL_DAYS=120

# Pyth Benchmarks (public, no key)
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network

# Loop cadence in seconds (docker entrypoint: python -m scorer loop)
RADAR_INTERVAL_S=60
FULL_RUN_INTERVAL_S=3600
RETRAIN_INTERVAL_S=604800
TRACK_RECORD_INTERVAL_S=86400

# Deterministic seed for the model and the synthetic world
SCORER_SEED=20261012
LOG_LEVEL=INFO

# Optional: hard cap on Helius HTTP requests per run (protects the free tier credits; the backfill resumes next run)
HELIUS_MAX_REQUESTS_PER_RUN=3000
# Optional: bearer key for Pyth Benchmarks if the service requires one
PYTH_API_KEY=
# Where the generated model card is written (default: services/scorer/MODEL_CARD.md)
MODEL_CARD_PATH=
