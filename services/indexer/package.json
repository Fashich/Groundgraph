{
  "name": "@groundgraph/indexer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Groundgraph program indexer: follows the on-chain program and mirrors it into Postgres",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "backfill": "tsx src/backfill.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@groundgraph/db": "workspace:*",
    "@groundgraph/sdk": "workspace:*",
    "@groundgraph/svc-core": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "ioredis": "5.11.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3"
  }
}
