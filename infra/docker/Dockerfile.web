# syntax=docker/dockerfile:1.7
#
# Groundgraph web app image (Next.js, `output: 'standalone'`).
# Build context MUST be the repository root:
#   docker build -f infra/docker/Dockerfile.web -t groundgraph-web \
#     --build-arg NEXT_PUBLIC_SITE_URL=https://app.example.com \
#     --build-arg NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com \
#     --build-arg NEXT_PUBLIC_USDC_MINT=<test usdc mint> \
#     --build-arg API_ORIGIN=http://api:8787 .
#   docker run -p 3000:3000 -e BLOCKED_COUNTRIES=US,CU,IR,KP,SY groundgraph-web
#
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build time, and so is API_ORIGIN (the
# /api and /og rewrites are resolved by `next build`). Those are build arguments below. The only value read at run
# time is BLOCKED_COUNTRIES (proxy.ts). No secret belongs in this image: the browser never holds one.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo

# Stage 1: only the manifests and the lockfile, so the dependency layer is rebuilt only when they change.
FROM base AS manifests
COPY . /ctx
RUN mkdir /out && cd /ctx \
 && find . -type f \( -name package.json -o -name pnpm-lock.yaml -o -name pnpm-workspace.yaml -o -name .npmrc \) -not -path '*/node_modules/*' -print0 \
    | tar --null -T - -cf - | tar -xf - -C /out

# Stage 2: install the workspace closure of the web app (with the lockfile frozen).
FROM base AS deps
COPY --from=manifests /out/ ./
RUN --mount=type=cache,id=gg-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store --filter "@groundgraph/web..."

# Stage 3: sources, then the production build. programs/groundgraph/deployments/devnet.json is read by the SDK for the default program id.
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages ./packages
# Only what the build reads (no tests, mock API, screenshots or e2e build output).
COPY apps/web/package.json apps/web/next.config.ts apps/web/tsconfig.json apps/web/postcss.config.mjs ./apps/web/
COPY apps/web/src ./apps/web/src
COPY apps/web/public ./apps/web/public
COPY apps/web/content ./apps/web/content
COPY programs/groundgraph/deployments ./programs/groundgraph/deployments
ARG API_ORIGIN=http://localhost:8787
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_WS_URL=
ARG NEXT_PUBLIC_SOLANA_CLUSTER=devnet
ARG NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
ARG NEXT_PUBLIC_USDC_MINT=
ARG NEXT_PUBLIC_PROGRAM_ID=
ARG NEXT_PUBLIC_TOS_VERSION=2026-10-01
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV API_ORIGIN=$API_ORIGIN \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_PUBLIC_SOLANA_CLUSTER=$NEXT_PUBLIC_SOLANA_CLUSTER \
    NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL \
    NEXT_PUBLIC_USDC_MINT=$NEXT_PUBLIC_USDC_MINT \
    NEXT_PUBLIC_PROGRAM_ID=$NEXT_PUBLIC_PROGRAM_ID \
    NEXT_PUBLIC_TOS_VERSION=$NEXT_PUBLIC_TOS_VERSION \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NODE_ENV=production
RUN pnpm --filter @groundgraph/web build

# Stage 4: the traced standalone server only. Static assets, public files and the legal documents are copied next to it
# (Next does not put .next/static or public in the standalone folder).
FROM node:22-slim AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
COPY --from=build --chown=node:node /repo/apps/web/content ./apps/web/content
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
# One process, no wrapper: SIGTERM reaches the Next server directly.
WORKDIR /app/apps/web
CMD ["node", "server.js"]
