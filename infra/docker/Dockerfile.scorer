# syntax=docker/dockerfile:1.7
#
# Groundgraph scorer image (Python 3.11, CPU only PyTorch).
# Build context MUST be the repository root:
#   docker build -f infra/docker/Dockerfile.scorer -t groundgraph-scorer .
#
# NOT BUILT in the environment this file was written in (the CPU wheel index is blocked there). The same pinned
# versions were exercised from the PyPI wheels in a local virtualenv, see services/scorer/README.md.
#
# Configuration is environment only: DATABASE_URL, DEMO_MODE, HELIUS_API_KEY, SCORER_SOURCE (see services/scorer/.env.example).
# The container runs `python -m scorer loop`: radar every 60 s, the full pipeline hourly, retraining weekly and the
# track record nightly. SCORER_SOURCE=synthetic is refused unless DEMO_MODE=true.

FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1
WORKDIR /app

# Dependencies first so the layer is rebuilt only when the pins change. torch comes from the CPU wheel index
# (no CUDA libraries, a few hundred MB instead of several GB); everything else is pure PyPI.
FROM base AS deps
COPY services/scorer/pyproject.toml ./pyproject.toml
RUN pip install --index-url https://download.pytorch.org/whl/cpu "torch==2.14.1" \
 && python - <<'PY'
import re, tomllib
deps = tomllib.load(open("pyproject.toml", "rb"))["project"]["dependencies"]
open("requirements.txt", "w").write("\n".join(d for d in deps if not d.startswith("torch")) + "\n")
PY
RUN pip install -r requirements.txt

FROM deps AS runtime
COPY services/scorer/pyproject.toml services/scorer/README.md ./
COPY services/scorer/scorer ./scorer
RUN useradd --system --uid 10001 --home-dir /app scorer && mkdir -p /data && chown scorer /data
USER scorer
# MODEL_CARD.md is regenerated by every training run; keep it on a writable path (mount a volume to keep it).
ENV MODEL_CARD_PATH=/data/MODEL_CARD.md \
    SCORER_SOURCE=helius \
    DEMO_MODE=false
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
  CMD python -c "import os,psycopg; psycopg.connect(os.environ['DATABASE_URL'], connect_timeout=5).close()" || exit 1
ENTRYPOINT ["python", "-m", "scorer"]
CMD ["loop"]
